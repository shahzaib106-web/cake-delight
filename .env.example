# ─────────────────────────────────────────────────────────────
# Cake Delight — environment configuration
# Copy to .env.local and fill in your Supabase project credentials.
# WITHOUT these vars the app runs on a built-in local JSON store
# (data/db.json) — perfect for development and demos.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Which Supabase Auth account may access the admin dashboard (login accepts this email or just the part before @).
ADMIN_EMAIL=admin@cakedelight.pk

# Secret used to sign admin session tokens (local mode).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-to-a-long-random-string
